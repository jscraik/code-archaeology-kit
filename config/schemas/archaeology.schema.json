{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code Archaeology Kit Scan Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "settings",
    "notices",
    "run_metadata",
    "detectors",
    "base_metrics",
    "dig_plan",
    "actionability",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_path", "head_commit", "generated_at_utc", "since_days", "total_commits"],
      "properties": {
        "repo_path": {"type": "string", "minLength": 1},
        "head_commit": {"type": "string", "pattern": "^[a-f0-9]{7,40}$"},
        "generated_at_utc": {"type": "string", "format": "date-time"},
        "since_days": {"type": "integer", "minimum": 1},
        "total_commits": {"type": "integer", "minimum": 0}
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_churn_threshold",
        "include_authors",
        "include_repo_path",
        "include_commit_messages",
        "max_commits",
        "max_files_per_commit",
        "timeout_seconds",
        "top_actions",
        "large_commit_strategy",
        "use_default_ignores"
      ],
      "properties": {
        "min_churn_threshold": {"type": "integer", "minimum": 1},
        "include_authors": {"type": "boolean"},
        "include_repo_path": {"type": "boolean"},
        "include_commit_messages": {"type": "boolean"},
        "max_commits": {"type": "integer", "minimum": 1},
        "max_files_per_commit": {"type": "integer", "minimum": 2},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "top_actions": {"type": "integer", "minimum": 1},
        "large_commit_strategy": {"type": "string", "enum": ["cap", "skip"]},
        "use_default_ignores": {"type": "boolean"}
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    },
    "run_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "tool_version",
        "schema_path",
        "truncated",
        "runtime_ms",
        "ignore_rules_applied"
      ],
      "properties": {
        "tool": {"type": "string", "const": "cak scan"},
        "tool_version": {"type": "string"},
        "schema_path": {"type": "string"},
        "truncated": {"type": "boolean"},
        "runtime_ms": {"type": "integer", "minimum": 0},
        "ignore_rules_applied": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "detectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abandoned_structures", "temporal_coupling", "era_segmentation"],
      "properties": {
        "abandoned_structures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "path_class",
              "historical_commits",
              "recent_commits",
              "days_since_last_change",
              "authors",
              "confidence",
              "confidence_explainer"
            ],
            "properties": {
              "file": {"type": "string"},
              "path_class": {
                "type": "string",
                "enum": ["product", "test", "infra", "docs", "generated", "unknown"]
              },
              "historical_commits": {"type": "integer", "minimum": 1},
              "recent_commits": {"type": "integer", "minimum": 0},
              "days_since_last_change": {"type": "integer", "minimum": 0},
              "authors": {"type": "integer", "minimum": 0},
              "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
              "confidence_explainer": {"type": "string"}
            }
          }
        },
        "temporal_coupling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pairs", "skipped_large_commits", "capped_large_commits", "max_files_per_commit"],
          "properties": {
            "pairs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file_a",
                  "file_b",
                  "class_a",
                  "class_b",
                  "co_change_commits",
                  "coupling_ratio",
                  "coupling_class",
                  "confidence",
                  "confidence_explainer"
                ],
                "properties": {
                  "file_a": {"type": "string"},
                  "file_b": {"type": "string"},
                  "class_a": {"type": "string"},
                  "class_b": {"type": "string"},
                  "co_change_commits": {"type": "integer", "minimum": 2},
                  "coupling_ratio": {"type": "number", "minimum": 0, "maximum": 1},
                  "coupling_class": {
                    "type": "string",
                    "enum": ["expected", "risky", "suspicious"]
                  },
                  "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
                  "confidence_explainer": {"type": "string"}
                }
              }
            },
            "skipped_large_commits": {"type": "integer", "minimum": 0},
            "capped_large_commits": {"type": "integer", "minimum": 0},
            "max_files_per_commit": {"type": "integer", "minimum": 2}
          }
        },
        "era_segmentation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["era", "label", "commits", "growth_signal", "top_churn_file"],
            "properties": {
              "era": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
              "label": {"type": "string", "enum": ["expansion", "stabilization", "maintenance"]},
              "commits": {"type": "integer", "minimum": 0},
              "growth_signal": {"type": "integer"},
              "top_churn_file": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "base_metrics": {
      "type": "object",
      "required": ["file_churn", "file_growth", "commit_themes", "recent_refactors", "time_buckets", "language_breakdown"],
      "properties": {
        "file_churn": {"type": "array"},
        "file_growth": {"type": "array"},
        "commit_themes": {"type": "object"},
        "recent_refactors": {"type": "array"},
        "time_buckets": {"type": "array"},
        "language_breakdown": {"type": "array"},
        "author_activity": {"type": "array"}
      }
    },
    "dig_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "action", "target", "effort", "expected_leverage", "rationale"],
        "properties": {
          "priority": {"type": "string", "enum": ["high", "medium", "low"]},
          "action": {"type": "string"},
          "target": {"type": "string"},
          "effort": {"type": "string", "enum": ["low", "medium", "high"]},
          "expected_leverage": {"type": "string", "enum": ["low", "medium", "high"]},
          "rationale": {"type": "string"}
        }
      }
    },
    "actionability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top_actions"],
      "properties": {
        "top_actions": {
          "type": "array",
          "items": {
            "$ref": "#/properties/dig_plan/items"
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    }
  }
}
